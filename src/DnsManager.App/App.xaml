<Application x:Class="DnsManager.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DnsManager.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Базовые стили контролов (цвета — через DynamicResource на кисти тем) -->
                <ResourceDictionary Source="Themes/Controls.xaml" />
                <!-- Кисти текущей темы; заменяется ThemeManager.Apply при переключении -->
                <ResourceDictionary Source="Themes/LightTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
