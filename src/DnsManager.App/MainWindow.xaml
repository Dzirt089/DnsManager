<Window x:Class="DnsManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:DnsManager.App.Converters"
        mc:Ignorable="d"
        Title="DNS Manager" Height="760" Width="1100" MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen" Icon="Assets/app.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="GroupBoxCard" TargetType="GroupBox">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <!-- Общий стиль DataGrid: колонки можно раздвигать, при нехватке места — скролл.
             BasedOn на implicit-стиль темы, чтобы не терять тёмный фон/текст. -->
        <Style x:Key="ResizableGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="CanUserResizeColumns" Value="True" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
        </Style>
    </Window.Resources>

    <!-- Отзывчивый layout: строки перераспределяются при ресайзе, лог тянется за GridSplitter -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="DnsPanelRow" Height="190" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="LogPanelRow" Height="240" MinHeight="140" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="DNS Manager" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Text="Windows 11" Margin="10,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="ThemeButton" Content="Тёмная тема" Padding="10,4"
                    VerticalAlignment="Center" Click="ThemeButton_Click" />
        </Grid>

        <!-- Панель управления DNS -->
        <GroupBox Grid.Row="1" Header="Управление DNS" Style="{StaticResource GroupBoxCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Выбор адаптера -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="Сетевой адаптер:" Style="{StaticResource SectionHeader}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Обновить" Margin="6,0,0,0" Padding="10,4"
                                Command="{Binding RefreshAdaptersCommand}" />
                        <ComboBox ItemsSource="{Binding Adapters}"
                                  SelectedItem="{Binding SelectedAdapter}"
                                  DisplayMemberPath="Name"
                                  VerticalContentAlignment="Center" Height="30" />
                    </DockPanel>
                    <TextBlock Text="{Binding NetworkInfoText}" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>

                <!-- Текущее состояние -->
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="Текущий DNS:" Style="{StaticResource SectionHeader}" />
                    <Border Background="{DynamicResource InfoBoxBackground}" BorderBrush="{DynamicResource InfoBoxBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
                        <TextBlock Text="{Binding DnsStateText}" TextWrapping="Wrap" FontWeight="Medium" />
                    </Border>
                </StackPanel>

                <!-- Кнопки -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Button Content="Включить DNS" Command="{Binding EnableDnsCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button Content="Выключить (DHCP)" Command="{Binding DisableDnsCommand}" Padding="16,8" FontSize="14"
                            Margin="0,8,8,0" />
                    <Button Content="Применить пресет" Command="{Binding ApplyPresetCommand}" Padding="16,8" FontSize="14"
                            Margin="0,8,8,0" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Вкладки -->
        <TabControl Grid.Row="3">
            <TabItem Header="Пресеты">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="PresetListColumn" Width="240" MinWidth="180" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Список пресетов -->
                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="DNS-профили" Style="{StaticResource SectionHeader}" />
                        <ListBox Grid.Row="1" ItemsSource="{Binding Presets.Presets}"
                                 SelectedItem="{Binding Presets.SelectedPreset}"
                                 DisplayMemberPath="Name"
                                 MouseDoubleClick="PresetsList_MouseDoubleClick" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Добавить" Command="{Binding Presets.AddPresetCommand}" Padding="10,4" />
                            <Button Content="Удалить" Command="{Binding Presets.DeletePresetCommand}"
                                    CommandParameter="{Binding Presets.SelectedPreset}" Padding="10,4" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Row="3" Text="Минимум один пресет. Изменения сохраняются автоматически."
                                   TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,8,0,0" />
                    </Grid>

                    <!-- Разделитель ширины списка профилей -->
                    <GridSplitter Grid.Column="1" Width="6" Margin="0,0,12,0"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                                  DragCompleted="Splitter_DragCompleted" />

                    <!-- Редактор -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Редактор пресета" Style="{StaticResource SectionHeader}" />
                        <DockPanel Grid.Row="1" Margin="0,0,0,8">
                            <TextBlock Text="Название:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="PresetNameBox"
                                     Text="{Binding Presets.SelectedPreset.Name, UpdateSourceTrigger=PropertyChanged}"
                                     Height="26" GotKeyboardFocus="PresetNameBox_GotKeyboardFocus" />
                        </DockPanel>
                        <DataGrid Grid.Row="2" Style="{StaticResource ResizableGrid}"
                                  ItemsSource="{Binding Presets.SelectedPreset.Servers}"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  SelectionMode="Single"
                                  CellEditEnding="PresetsGrid_CellEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="*" MinWidth="140" />
                                <DataGridCheckBoxColumn Header="DoH вкл" Binding="{Binding DohEnabled}" Width="80" MinWidth="70" />
                                <DataGridCheckBoxColumn Header="Fallback" Binding="{Binding AllowFallbackToUdp}" Width="90" MinWidth="80" />
                                <DataGridTextColumn Header="DoH-шаблон" Binding="{Binding DohTemplate}" Width="2*" MinWidth="180" />
                                <DataGridTemplateColumn Header="" Width="36">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" Padding="4,0" FontSize="10"
                                                    Command="{Binding DataContext.Presets.RemoveServerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Добавить сервер" Command="{Binding Presets.AddServerCommand}" Padding="10,4" />
                        </StackPanel>
                        <TextBlock Grid.Row="4" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,8,0,0">
                            DoH: «включено (автоматический шаблон)» = галка DoH вкл;
                            DoH-шаблон (необязательно) — если указан, используется как эндпоинт DoH;
                            «возврат к обычному тексту откл» = снятая галка Fallback.
                            Двойной клик по пресету — переименовать (сохраняется автоматически).
                        </TextBlock>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Тест резолвинга">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Проверить" Command="{Binding Resolution.RunCommand}"
                                Style="{StaticResource PrimaryButton}" VerticalAlignment="Top" />
                        <TextBlock Text="Домены (по одному на строку):" Style="{StaticResource SectionHeader}" />
                        <TextBox Text="{Binding Resolution.DomainsText}" AcceptsReturn="True" Height="70"
                                 VerticalScrollBarVisibility="Auto" />
                    </DockPanel>
                    <DataGrid Grid.Row="1" Style="{StaticResource ResizableGrid}"
                              ItemsSource="{Binding Resolution.Results}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Домен" Binding="{Binding Host}" Width="*" MinWidth="140" />
                            <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="70" MinWidth="60" />
                            <DataGridTextColumn Header="IP-адреса" Binding="{Binding AddressesText}" Width="2*" MinWidth="160" />
                            <DataGridTextColumn Header="Время, мс" Binding="{Binding ElapsedMs}" Width="90" MinWidth="80" />
                            <DataGridTextColumn Header="Ошибка" Binding="{Binding Error}" Width="2*" MinWidth="160" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Бенчмарк DNS">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Запустить" Command="{Binding Benchmark.RunBenchmarkCommand}"
                                Style="{StaticResource PrimaryButton}" VerticalAlignment="Top" />
                        <TextBlock Text="Серверы (IP по одному на строку):" Style="{StaticResource SectionHeader}" />
                        <TextBox Text="{Binding Benchmark.ServersText}" AcceptsReturn="True" Height="80"
                                 VerticalScrollBarVisibility="Auto" />
                    </DockPanel>
                    <DataGrid Grid.Row="1" Style="{StaticResource ResizableGrid}"
                              ItemsSource="{Binding Benchmark.Results}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Сервер" Binding="{Binding Server}" Width="*" MinWidth="140" />
                            <DataGridTextColumn Header="Успешно" Binding="{Binding SuccessfulQueries}" Width="80" MinWidth="60" />
                            <DataGridTextColumn Header="Всего" Binding="{Binding TotalQueries}" Width="70" MinWidth="55" />
                            <DataGridTextColumn Header="Потери, %" Binding="{Binding LossPercent, StringFormat={}{0:F1}}" Width="90" MinWidth="70" />
                            <DataGridTextColumn Header="Мин, мс" Binding="{Binding MinMs}" Width="80" MinWidth="60" />
                            <DataGridTextColumn Header="Среднее, мс" Binding="{Binding AvgMs}" Width="90" MinWidth="70" />
                            <DataGridTextColumn Header="Макс, мс" Binding="{Binding MaxMs}" Width="80" MinWidth="60" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="{Binding Benchmark.StatusText}" Margin="0,6,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                </Grid>
            </TabItem>

            <TabItem Header="Настройки">
                <StackPanel Margin="8">
                    <TextBlock Text="Настройки" Style="{StaticResource SectionHeader}" />
                    <CheckBox Content="Автозапуск при входе в Windows"
                              IsChecked="{Binding IsAutostartEnabled}"
                              Command="{Binding ToggleAutostartCommand}"
                              Margin="0,4,0,12" />
					<Button Content="Проверить обновление"
                              Command="{Binding CheckForUpdateCommand}"
                              Width="200"
                              HorizontalAlignment="Left"
                              Margin="0,4,0,12"/>
					<TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12">
                        Приложение требует прав администратора и будет сворачиваться в системный трей при закрытии окна.
                        Выход — через меню иконки в трее.
                    </TextBlock>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Разделитель: высота панели управления DNS -->
        <GridSplitter Grid.Row="2" Height="6" Margin="0,2,0,2"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      DragCompleted="Splitter_DragCompleted" />

        <!-- Разделитель: тянет высоту лога -->
        <GridSplitter Grid.Row="4" Height="6" Margin="0,2,0,2"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      DragCompleted="Splitter_DragCompleted" />

        <!-- Лог -->
        <GroupBox Grid.Row="5" Header="Лог действий и ответов системы" Style="{StaticResource GroupBoxCard}" Margin="0,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="Сохранить лог..." Command="{Binding SaveLogsCommand}" Padding="10,2" Margin="8,0,0,0" />
                    <Button DockPanel.Dock="Right" Content="Очистить" Command="{Binding ClearLogsCommand}" Padding="10,2" />
                    <TextBlock Text="{Binding Logs.Count, StringFormat='Записей: {0}'}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                </DockPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding Logs}" x:Name="LogList"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="NoWrap">
                                <Run Text="{Binding DisplayTimestamp, Mode=OneWay}" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <Run Text=" " />
                                <Run Text="{Binding LevelText, Mode=OneWay}" FontWeight="Bold">
                                    <Run.Style>
                                        <Style TargetType="Run">
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LevelText}" Value="ERROR">
                                                    <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LevelText}" Value="WARN">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarnTextBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LevelText}" Value="DEBUG">
                                                    <Setter Property="Foreground" Value="{DynamicResource DebugTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Run.Style>
                                </Run>
                                <Run Text=" " />
                                <Run Text="{Binding Message, Mode=OneWay}" />
                                <Run Text="{Binding PropertiesText, Mode=OneWay}" Foreground="{DynamicResource MutedTextBrush}" />
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </GroupBox>

        <!-- Статусбар -->
        <StatusBar Grid.Row="6">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusBarText}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Width="120" Height="14" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
