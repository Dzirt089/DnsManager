<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Маркер для поиска словаря темы при переключении -->
    <sys:String x:Key="ThemeName">Dark</sys:String>

    <!-- Общие -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="TextBrush" Color="#E6E6E6" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9E9E9E" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#8A8A8A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InfoBoxBackground" Color="#262626" />
    <SolidColorBrush x:Key="InfoBoxBorderBrush" Color="#4A9EE0" />
    <SolidColorBrush x:Key="SplitterBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#FF7B72" />
    <SolidColorBrush x:Key="WarnTextBrush" Color="#E0A83C" />
    <SolidColorBrush x:Key="DebugTextBrush" Color="#777777" />

    <!-- Контролы -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#2D2D30" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#3F3F46" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#3E3E42" />
    <SolidColorBrush x:Key="GroupBoxBorderBrush" Color="#3F3F46" />
    <SolidColorBrush x:Key="TabBackgroundBrush" Color="#252526" />
    <SolidColorBrush x:Key="TabSelectedBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush" Color="#333337" />
    <SolidColorBrush x:Key="DataGridGridLineBrush" Color="#333333" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#2D2D30" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#5A5A5A" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#777777" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#252526" />
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#3F3F46" />
    <SolidColorBrush x:Key="ProgressIndicatorBrush" Color="#0078D4" />
</ResourceDictionary>
